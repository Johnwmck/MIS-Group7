# Copy to API/.env and add your authorized university key. Never commit .env.
MIS_LLM_KEY=your-authorized-key-here
# The handout spelling MIS_LLM_KeY is also accepted.
MIS_LLM_ENDPOINT=https://local-llm.uamishub.com/v1
MIS_LLM_MODEL=qwen3.8-27b
MIS_LLM_TIMEOUT_SECONDS=150
MIS_LLM_MAX_TOKENS=1800
# For first startup outside Development, set both staff seed passwords:
# BOOKSTORE_ADMIN_PASSWORD=your-admin-password
# BOOKSTORE_EMPLOYEE_PASSWORD=your-employee-password
