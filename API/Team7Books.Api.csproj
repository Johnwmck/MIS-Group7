<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- JSON is already included by the Web SDK; only update its copy metadata. -->
    <Content Update="SeedData/description-baseline.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Local user state must never be shipped or copied over a runtime snapshot. -->
    <Content Update="App_Data/**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Include="../Seed Data/Team7_SeedBooks.csv" Link="SeedData/Team7_SeedBooks.csv"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
